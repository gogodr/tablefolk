# Copy the web variables to apps/web/.env.local for local Next.js development.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# API variables. The API also reads the repository root .env in local development.
CLERK_PUBLISHABLE_KEY=
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
DATABASE_URL=
DIRECT_URL=
BGG_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Set true only after the BGG application license permits storing and displaying covers in PostgreSQL.
BGG_COVER_STORAGE_ALLOWED=false
